# Tests for fixes in the HPACK library.
# table <max size> <new|keep>, hex <block>, header <name> <value>,
# size <dynamic table size after decoding>, fail: the block is invalid.
# A vector without hex only tests encoding and decoding of the headers.

# test literal string longer than the block
table 4096 new
hex 400a6375
fail
end

# test integer longer than 31 bits
table 4096 new
hex 0fffffffffffff01
fail
end

# test dynamic table size update after a header field
table 4096 new
hex 823fe11f
fail
end

# test dynamic table size update at the beginning
table 4096 new
hex 3fe11f82
header :method GET
size 0
end

# test dynamic table size update above the maximum
table 4096 new
hex 3fe21f82
fail
end
