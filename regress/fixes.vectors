# Tests for fixes in the HPACK library.
# table <max size> <new|keep>, hex <block>, header <name> <value>,
# size <dynamic table size after decoding>, fail: the block is invalid.
# A vector without hex only tests encoding and decoding of the headers.

# test literal string longer than the block
table 4096 new
hex 400a6375
fail
end

# test integer longer than 31 bits
table 4096 new
hex 0fffffffffffff01
fail
end

# test dynamic table size update after a header field
table 4096 new
hex 823fe11f
fail
end

# test dynamic table size update at the beginning
table 4096 new
hex 3fe11f82
header :method GET
size 0
end

# test dynamic table size update above the maximum
table 4096 new
hex 3fe21f82
fail
end

# test Huffman string with padding that is not all ones
table 4096 new
hex 008118811f
fail
end

# test Huffman string with valid padding
table 4096 new
hex 00811f811f
header a a
size 0
end

# test Huffman string with more than 7 bits of padding
table 4096 new
hex 00821fff811f
fail
end

# test Huffman string with EOS
table 4096 new
hex 0084ffffffff811f
fail
end

# test NUL in a literal string
table 4096 new
hex 000161026100
fail
end

# test encoding of a length of 2^7 - 1
table 4096 new
header x !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
end

# test encoding of values that only differ in case, first
table 4096 new
header x-case abc
end

# test encoding of values that only differ in case, second
table 4096 keep
header x-case ABC
end
